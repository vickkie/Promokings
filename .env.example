# Client-safe environment variables for the Promokings mobile app.
# react-native-dotenv inlines every key below into the JS bundle at build
# time - treat all values here as PUBLIC. Server-side secrets
# (e.g. ONESIGNAL_REST_API_KEY) must live in the backend .env ONLY and must
# never be added here (MB-SEC-004).

# Backend API base URL (https)
BACKEND_PORT=

# EAS project id (expo push notifications)
EAS_PROJECT_ID=

# Firebase web config (public by design; protect data via RTDB/Storage rules)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_DATABASE_URL=

# OneSignal app id (public tenant id - NOT the REST API key)
ONESIGNAL_APP_ID=

# Google sign-in (OAuth client ids are public by design - no secrets).
# GOOGLE_CLIENT_ID is the shared fallback; the _ANDROID/_IOS variants
# override it per platform when set. For dev-client/production builds use
# native-type OAuth clients (Android client needs the app package name +
# signing SHA-1 - see docs_local/audit/04-google-login.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=

# App version strings displayed in the UI
VERSION_LONG=
VERSION_SHORT=
